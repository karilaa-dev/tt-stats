---
import "../styles.css"
interface Props {
  title: string
}
const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Download analytics and operations for tt-bot."
    />
    <meta name="theme-color" content="#f3f7fa" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
