---
import Layout from "@/src/layouts/base.astro"
import Dashboard from "@/components/pages/videos-island"
import { isFakeDataEnabled } from "@/lib/dev/fake-data"
const pathname = Astro.url.pathname.replace(/\/$/, "")
---

<Layout title="Most downloaded videos · @ttgrab Stats">
  <Dashboard
    client:load
    pathname={pathname}
    search={Astro.url.search}
    fakeMode={isFakeDataEnabled()}
  />
</Layout>
