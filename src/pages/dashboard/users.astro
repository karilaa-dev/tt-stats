---
import { localeFromRequest } from "@/lib/i18n/locale"
import Layout from "@/src/layouts/base.astro"
import Dashboard from "@/components/pages/users-island"
import { isFakeDataEnabled } from "@/lib/dev/fake-data"
const pathname = Astro.url.pathname.replace(/\/$/, "")
---

<Layout title="User lookup · @ttgrab Stats">
  <Dashboard
    locale={localeFromRequest(Astro.cookies, Astro.request)}
    client:load
    pathname={pathname}
    search={Astro.url.search}
    fakeMode={isFakeDataEnabled()}
  />
</Layout>
