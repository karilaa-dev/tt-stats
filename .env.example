# Read-only access to the current tt-bot PostgreSQL database.
DB_URL=postgresql://tt_stats:replace-me@127.0.0.1:5432/ttbot-db
DB_POOL_SIZE=5

# Shared website credentials and the secret used to sign 12-hour sessions.
STATS_USERNAME=admin
STATS_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Manual Botstat.io verification.
BOT_TOKEN=12345:replace-with-telegram-bot-token
BOTSTAT_ACCESS_KEY=replace-with-botstat-access-key
BOTSTAT_NOTIFY_ID=1234567
BOTSTAT_BASE_URL=https://www.botstat.io
