# PostgreSQL connection. This role must not be a superuser; see README grants.
DB_URL=postgresql://tt_stats:replace-me@127.0.0.1:5432/ttbot-db
DB_POOL_SIZE=5

# Shared admin token, at least 32 characters. Generate with: openssl rand -hex 32
# Leave unset to keep Operations and individual user lookup locked.
ADMIN_TOKEN=

# Optional Telegram-calculated MAU. Supply all three to connect MTProto.
# Obtain API credentials at https://my.telegram.org/apps
# Saved-media previews require the token of the bot that owns the stored files.
# BOT_TOKEN=12345:replace-with-telegram-bot-token
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=replace-with-32-character-api-hash

# Optional video-download inactivity notifications. Configure exactly one.
# A generic webhook receives a JSON POST body.
# VIDEO_INACTIVITY_WEBHOOK_URL=https://example.com/webhooks/tt-stats

# Or publish to an ntfy topic URL. The bearer token is optional.
# VIDEO_INACTIVITY_NTFY_URL=https://ntfy.sh/replace-with-private-topic
# VIDEO_INACTIVITY_NTFY_TOKEN=replace-with-ntfy-access-token

# Development only: render deterministic sample data without PostgreSQL.
# TT_STATS_FAKE_DATA=true

# Development only: comma-separated public origins allowed to reach Vite.
# DEV_ALLOWED_ORIGINS=https://example.test
